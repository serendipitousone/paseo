# TWERK supply-chain hardening for our maintained Paseo fork (twerk/main).
#
# Why: npm lifecycle scripts (preinstall/install/postinstall/prepare) run with the
# installing user's privileges and are the #1 supply-chain RCE vector — Shai-Hulud
# (796 pkgs, 2025) and the Sept-2025 2B-downloads hijack both executed via install
# hooks. Pinning + committed lockfile + `npm ci` + ignore-scripts mitigates all of them.
# See docs/twerk-supply-chain.md for the full build procedure.

# Block ALL lifecycle scripts by default. Reviewed first-party scripts are run by hand.
ignore-scripts=true

# Never float a version. Any `npm install <pkg>` writes an exact pin, not a range.
save-exact=true

# Refuse to install if package.json and the lockfile disagree (no silent additions).
package-lock=true
engine-strict=true

# Only the canonical public registry; never a mirror that could be poisoned.
registry=https://registry.npmjs.org/

# Run the vuln audit on install; surface, don't auto-fix.
audit=true
audit-level=moderate

fund=false
